# Vigilante de Redmine → conversaciones de Poo IA. Copiar a ~/.config/poo-redmine-watcher/watcher.env (0600).
REDMINE_URL=http://redmine.example:4008
# Usuario y contraseña, o bien REDMINE_API_KEY (tiene prioridad).
REDMINE_USER=
REDMINE_PASSWORD=
# REDMINE_API_KEY=
REDMINE_POLL_SECONDS=60
# 1: al primer arranque, las incidencias ya asignadas se marcan como vistas.
REDMINE_SKIP_EXISTING=1
REDMINE_CREDENTIALS_HINT=~/.config/poo-ia/redmine.env
POO_GATEWAY=http://127.0.0.1:4199
POO_PASSPHRASE=
WATCHER_STATE_DIR=/home/poo/.local/state/poo-redmine-watcher
# Al tomar una incidencia: pasa a análisis y, en la misma petición, el acuse de recibo con
# una frase del catálogo de redmine/flow.ts que va alternando (REDMINE_ACK=0 lo apaga).
# REDMINE_PICKUP_STATUS=En análisis o en revisión
# REDMINE_PICKUP_FROM=Nuevo o Pendiente
# REDMINE_ACK=1
# «En curso» (al aprobar el plan) y «Terminado por Desarrollo» (al cerrar) no se configuran:
# son los estados del flujo del equipo (redmine/flow.ts).
# Tipo de las subtareas que se crean para el frontal.
# REDMINE_SUBTASK_TRACKER=Subtarea
# Modelos: el de análisis hace el alcance, el plan y las respuestas a comentarios; el de trabajo
# toma la tarea cuando empieza su bloque (ejecuta y publica); el supervisor entra cuando el
# agente cierra con «Etapa: EJECUTADO» o «Etapa: RESPUESTA». Sin REDMINE_ANALYSIS_MODEL todo va
# con el de trabajo; sin REDMINE_REVIEW_MODEL se pasa directo al cierre.
# REDMINE_ANALYSIS_MODEL=claude/claude-opus-5-5@medium
# POO_MODEL=devin/swe-2-high
# REDMINE_REVIEW_MODEL=claude/claude-opus-5-5@medium
# Rondas de corrección tras el supervisor y pasadas del supervisor por ciclo (un ciclo
# empieza con cada mensaje del propietario o comentario nuevo de Redmine).
# REDMINE_MAX_FIXES=1
# REDMINE_MAX_REVIEWS=2
# REDMINE_REVIEW_TIMEOUT_MINUTES=30
