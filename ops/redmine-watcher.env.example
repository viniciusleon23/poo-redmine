# Vigilante de Redmine → conversaciones de Poo IA. Copiar a ~/.config/poo-redmine-watcher/watcher.env (0600).
REDMINE_URL=http://redmine.example:4008
# Usuario y contraseña, o bien REDMINE_API_KEY (tiene prioridad).
REDMINE_USER=
REDMINE_PASSWORD=
# REDMINE_API_KEY=
REDMINE_POLL_SECONDS=120
# 1: al primer arranque, las incidencias ya asignadas se marcan como vistas.
REDMINE_SKIP_EXISTING=1
REDMINE_CREDENTIALS_HINT=~/.config/poo-ia/redmine.env
POO_GATEWAY=http://127.0.0.1:4199
POO_PASSPHRASE=
# POO_MODEL=
WATCHER_STATE_DIR=/home/poo/.local/state/poo-redmine-watcher
# Al tomar una incidencia: estado de «tomada» y, en la misma peticion, el acuse de
# recibo para quien la abrio, con una frase del catalogo de flow.ts que va alternando
# (REDMINE_ACK=0 lo apaga).
# REDMINE_PICKUP_STATUS=En curso
# REDMINE_PICKUP_FROM=Nuevo o Pendiente
# REDMINE_ACK=1
# Modelo de trabajo y supervisor. El supervisor entra cuando el agente cierra con
# «Etapa: EJECUTADO» o «Etapa: RESPUESTA»; sin REDMINE_REVIEW_MODEL se pasa directo al cierre.
# POO_MODEL=opencode-go/deepseek-v4.1-flash
# REDMINE_REVIEW_MODEL=claude/claude-opus-5-5@medium
# Rondas de correccion tras el supervisor y pasadas del supervisor por ciclo (un ciclo
# empieza con cada mensaje del propietario o comentario nuevo de Redmine).
# REDMINE_MAX_FIXES=1
# REDMINE_MAX_REVIEWS=2
# REDMINE_REVIEW_TIMEOUT_MINUTES=30
# El comentario de cierre lo publica el vigilante con bin/redmine_comentar.py cuando el
# propietario pulsa «Finalizar», y pasa la incidencia a «Espera validacion consultoria».
