# Agenda de Capital Network. Copiar a ~/.config/poo-redmine/agenda.env (0600).
# Sin AGENDA_LLAVE el vigilante funciona, pero no agenda ni pasa peticiones a «En curso».
AGENDA_URL=https://wscapnet.com.mx:9444/api/v1
# Llave de la aplicación y secreto de avisos: los entrega quien administra la agenda.
AGENDA_LLAVE=
AGENDA_SECRETO_AVISOS=
# A nombre de quién se agenda (el propietario).
AGENDA_USUARIO=persona@capnet.com.mx
# Jornada en la que se aparta tiempo. La agenda ya resta comida, festivos y ausencias.
AGENDA_ZONA=America/Mexico_City
AGENDA_JORNADA=09:00-18:00
# 1 = lunes … 7 = domingo.
AGENDA_DIAS=1,2,3,4,5
# Horas que se apartan cuando el plan no trae «Tiempo estimado».
AGENDA_HORAS_POR_DEFECTO=2
# Con quién se agenda cuando el plan nombra una dependencia frontal:
# clave:Nombre:correo en la agenda:cómo empieza su nombre en Redmine, separados por «;».
FRONT_PEOPLE=daniel:Daniel:daniel@capnet.com.mx:Daniel M;gigdem:Gigdem:gigdem@capnet.com.mx:Gigdem G
# La agenda para la app y la web: solo loopback; la pasarela la reenvía con este token.
AGENDA_HTTP_PORT=4197
# AGENDA_HTTP_TOKEN_FILE=/home/poo/.config/poo-redmine/http-token
