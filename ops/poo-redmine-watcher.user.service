[Unit]
Description=Poo IA · vigilante de Redmine (tareas asignadas → conversaciones de Poo IA)
After=poo-mobile-gateway.service network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/poo-ia-native
EnvironmentFile=%h/.config/poo-redmine-watcher/watcher.env
ExecStart=%h/.fnm/aliases/default/bin/node --import tsx apps/redmine-watcher/src/main.ts
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
